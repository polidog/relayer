<?php

declare(strict_types=1);

namespace App\Components;

use Polidog\Relayer\Auth\Authenticator;
use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Runtime\Element;

// Reads the relayer Authenticator session entry at render time so its output
// depends on the current user. Loaded via a deferred wrapper
// (UserHeaderDeferred) from the layout so the session lookup happens in a
// separate GET to `/_defer/user-header` — the cacheable main page never
// varies by user.
//
// Deferred components are autowired from the DI container just like pages, so
// this takes the Authenticator by type instead of reading $_SESSION — no
// session_start(), no session-key knowledge.
return function (array $props, Authenticator $auth): Element {
    $displayName = $auth->user()?->displayName;

    if (null === $displayName) {
        return (
            <a
                href="/login"
                className="rounded-md bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700"
            >
                Sign in
            </a>
        );
    }

    return (
        <div className="flex items-center gap-3">
            <span className="text-sm text-slate-500">
                Hi, <span className="font-medium text-slate-900">{$displayName}</span>
            </span>
            <a
                href="/dashboard"
                className="rounded-md border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
            >
                Dashboard
            </a>
        </div>
    );
};
