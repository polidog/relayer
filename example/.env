APP_ENV=dev

# DATABASE_DSN drives Relayer's Db layer: set it and PdoDatabase ->
# CachingDatabase (-> TraceableDatabase in dev) is auto-wired, so
# UserRepository just takes a `Database` dependency. The example sets it
# in public/index.php instead of here, because SQLite resolves a relative
# DSN path against the process cwd and the entrypoint is the only place
# that knows an absolute, cwd-independent path. A real app with a server
# DB (mysql:/pgsql:) would just put the DSN here.

# i18n: with two locales the resolver is active. Try the example with
# `?`-less paths under /ja, a `locale` cookie, or an `Accept-Language: ja`
# header — framework validation/HTTP messages and translations/ja.php
# resolve to Japanese. Drop these and the app stays single-locale English.
APP_LOCALE=en
APP_LOCALES=en,ja
LOCALE_COOKIE=locale
LOCALE_PATH_PREFIX=true

# Origin guard — wired by Relayer::boot() as the router guard (runs before
# everything, /_defer/* and the profiler included). Leave ORIGIN_SECRET
# unset and every request passes. Set it (here or in .env.local — never
# commit a real value) and requests without a matching `X-Origin-Secret`
# header get a 403. ORIGIN_SECRET_PREVIOUS keeps the old value valid while
# rotating; ORIGIN_GUARD_EXCEPT lists paths that skip the check;
# ORIGIN_GUARD_MODE=report only logs what would be rejected.
#ORIGIN_SECRET=
#ORIGIN_SECRET_PREVIOUS=
#ORIGIN_GUARD_HEADER=X-Origin-Secret
#ORIGIN_GUARD_EXCEPT=/healthz
#ORIGIN_GUARD_MODE=enforce

# Trusted proxy — also wired by Relayer::boot(). TRUSTED_PROXIES is the
# comma-separated CIDR list the forwarding header is honored from; unset =
# nothing is trusted and $request->clientIp() is REMOTE_ADDR.
# TRUSTED_PROXY_PRESET picks the header: fly (Fly-Client-IP; Fly's private
# network is fdaa::/16), cloudflare (CF-Connecting-IP) or xff
# (X-Forwarded-For, the default). CLOUDFLARE_IP_RANGES adds a Cloudflare
# layer behind the first one for Cloudflare → Fly: when Fly-Client-IP is
# one of these, CF-Connecting-IP is the user. Fetch them from
# https://www.cloudflare.com/ips-v4 and /ips-v6.
#TRUSTED_PROXIES=fdaa::/16
#TRUSTED_PROXY_PRESET=fly
#CLOUDFLARE_IP_RANGES=
